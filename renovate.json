{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests",
    ":dependencyDashboard"
  ],
  "description": "Dependency update PRs go to the default branch (dev), are grouped, and arrive once a week; security fixes come at any time.",
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "schedule": ["at any time"]
  },
  "postUpdateOptions": ["gomodTidy"],
  "packageRules": [
    {
      "description": "One PR for all non-major GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pinDigest"],
      "groupName": "GitHub Actions"
    },
    {
      "description": "One PR for all non-major Go module updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Go modules"
    },
    {
      "description": "Tools pinned in workflows and the Dockerfile via renovate comments",
      "matchManagers": ["custom.regex"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "CI tools"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions marked with a '# renovate: datasource=... depName=...' comment on the line above",
      "managerFilePatterns": ["/^\\.github/workflows/.+\\.ya?ml$/", "/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+(?:ARG )?[A-Z0-9_]+\\s*[:=]\\s*\"?(?<currentValue>[^\\s\"]+)\"?"
      ]
    }
  ]
}
