# Copy to .env and fill in. Never commit .env.
TALESPEAK_DOMAIN=talespeak.example.org
# TALESPEAK_HOSTS=talespeak.example.org,play.example.org   # names the engine answers; default: TALESPEAK_DOMAIN
GH_OWNER=your-github-user-or-org
TALESPEAK_VERSION=latest      # a release like 0.3.1, "latest", or "edge" for the dev server
TALESPEAK_KIDS_MODE=false     # true for servers where kids chat

# Who may register, see docs/accounts.md
# TALESPEAK_MODE=public           # or edu
# TALESPEAK_REGISTRATION=self     # self | off | sso
# TALESPEAK_CLASS_CODE=           # registering also needs this code (a secret: keep it here only)

# Optional email for reset links, see docs/admin-email.md
# (without it admins and teachers make one-time reset codes)
# TALESPEAK_EMAIL_REGISTRATION=true
# TALESPEAK_PUBLIC_URL=https://talespeak.example.org   # links in mails start with it
# TALESPEAK_SMTP_HOST=smtp.example.org
# TALESPEAK_SMTP_PORT=587         # 587 with starttls, 465 with tls
# TALESPEAK_SMTP_TLS=starttls     # starttls | tls; never unencrypted
# TALESPEAK_SMTP_USER=talespeak@example.org
# TALESPEAK_SMTP_PASSWORD=
# TALESPEAK_SMTP_FROM="Talespeak <no-reply@example.org>"

# Optional AI sidecar (docker compose --profile ai up -d)
# TALESPEAK_LLM_URL=http://llm:8081
# LLM_MODEL_FILE=LFM2.5-1.2B-Instruct-Q4_K_M.gguf
# LLM_THREADS=2

# Optional resource limits, see docs/admin-limits.md (empty = engine default)
# TALESPEAK_LUA_TIME=100ms
# TALESPEAK_LUA_CALL_MEMORY=32MiB
# TALESPEAK_LUA_PLAYER_MEMORY=4MiB
# TALESPEAK_LUA_CLIENT_MEMORY=64MiB
# TALESPEAK_LUA_STATE_MEMORY=256MiB
# TALESPEAK_PACK_IMAGE_MAX=2MiB
# TALESPEAK_MAX_CONNS=1000
# TALESPEAK_SIGNIN_RECHECK=1m
